# --- Secrets (NE JAMAIS COMMITTER ce fichier) ---
SECRET_KEY="change-moi-avec-une-vraie-cle"
DEBUG=True

# --- Base de données ---
# Mode SQLite local (défaut) : ne rien renseigner.
# Ou PostgreSQL : renseigner soit DATABASE_URL (recommandé, ex. Neon) :
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# soit les champs individuels avec DB_ENGINE=postgres :
# DB_ENGINE=postgres
# DB_NAME=...
# DB_USER=...
# DB_PASSWORD=...
# DB_HOST=...
# DB_PORT=5432

# --- Hôtes autorisés (séparés par des virgules) ---
ALLOWED_HOSTS="localhost,127.0.0.1,monsite.onrender.com"

# --- Origines frontend autorisées (CORS) ---
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://monsite.onrender.com"

# --- Origines de confiance CSRF (formulaires Django derrière HTTPS) ---
CSRF_TRUSTED_ORIGINS="https://monsite.onrender.com"

# --- Sert le frontend React compilé via Django (True en production monolithique) ---
DJANGO_SERVE_SPA=False